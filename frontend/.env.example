# --- Local Development ---
# In development, leave as /api/v1 so Vite dev server proxies requests to localhost:8000:
# VITE_API_BASE_URL=/api/v1

# --- Production Deployment (Vercel) ---
# Set this in Vercel Environment Variables to your Render backend URL:
VITE_API_BASE_URL=https://<your-backend-app>.onrender.com/api/v1
