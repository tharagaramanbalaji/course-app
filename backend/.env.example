# --- General Settings ---
PROJECT_NAME="Course Training Platform"
ENVIRONMENT=production
DEBUG=false

# --- Database ---
# For Render / Supabase / Neon: Provide the connection string directly:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# Or configure individual host parameters for local development:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=courseapp
POSTGRES_PASSWORD=courseapp
POSTGRES_DB=courseapp

# --- Auth Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-every-real-environment
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Frontend & CORS ---
# In production, set to your Vercel deployment URL:
FRONTEND_URL=https://<your-app>.vercel.app
BACKEND_CORS_ORIGINS=["https://<your-app>.vercel.app"]

# --- Enterprise SSO (Google Workspace - Optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SSO_ALLOWED_DOMAINS=[]

# --- PDFMonkey Certificate Generation (Optional) ---
PDFMONKEY_API_KEY=""
PDFMONKEY_TEMPLATE_ID=""
PDFMONKEY_BASE_URL="https://api.pdfmonkey.io/api/v1"
